# JWT Secret (troque por uma senha forte em produção)
JWT_SECRET=coloque_uma_senha_forte_aqui

# Porta do servidor
PORT=3001

# Modo HTTPS: http | letsencrypt | cert
HTTPS_MODE=http

# Domínio (para HTTPS e CORS)
DOMAIN=moliveiraseguranca.com.br

# CORS (origens permitidas, separadas por vírgula)
CORS_ORIGIN=http://localhost:3001,https://moliveiraseguranca.com.br,https://www.moliveiraseguranca.com.br

# Banco de dados (relativo ao admin-server/)
DB_PATH=data/site.db

# Diretório de uploads locais (fallback quando Supabase não está configurado)
UPLOAD_DIR=uploads

# Supabase — armazenamento gratuito para fotos/logos (1GB grátis, sem cartão)
# 1. Crie conta em https://supabase.com (gratuito, sem cartão)
# 2. Crie um novo projeto
# 3. Vá em Storage → Create bucket (nome: uploads, público: sim)
# 4. Vá em Settings → API Keys
#    - Project URL → SUPABASE_URL
#    - Secret key (sb_secret_...) → SUPABASE_SECRET_KEY
#      (ou Service Role Key legada eyJ... → SUPABASE_SERVICE_KEY)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=uploads

# URL base para uploads (fallback quando Supabase não está configurado)
# Ex: https://moliveira-admin.onrender.com
UPLOADS_BASE_URL=

# Login persistente via env vars (grátis — senha não é resetada a cada deploy).
# Gere o hash: node -e "console.log(require('bcryptjs').hashSync('SUA_SENHA', 10))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=coloque_o_hash_bcrypt_aqui

# Email para Let's Encrypt
LETSENCRYPT_EMAIL=contato@moliveiraseguranca.com.br

# Certificados SSL (modo cert)
SSL_KEY_PATH=
SSL_CERT_PATH=

# SMTP para notificação de leads (opcional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu@email.com
SMTP_PASS=sua_senha
NOTIFY_EMAIL=contato@moliveiraseguranca.com.br
